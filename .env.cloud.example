# 仅在百炼应用的服务端环境变量配置，真实值不上传到源码或网页。
GUANZHAO_DEPLOYMENT=cloud-online
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
TAVILY_API_KEY=
# 至少32字符随机秘密，用于访客Cookie签名，不能使用上述API密钥代替。
GUANZHAO_SESSION_SECRET=
# 部署前填写固定的UTC结束时刻，例如ISO8601格式；为空、过期或无时区时拒绝付费调用。
GUANZHAO_ONLINE_UNTIL=
GUANZHAO_TASK_LIMIT=3
GUANZHAO_DATA_DIR=/tmp/guanzhao-online
PORT=8080
